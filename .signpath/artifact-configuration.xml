<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath 아티팩트 구성. SignPath 프로젝트의 Artifact Configuration 에 이 내용을 그대로 넣는다.
     GitHub Actions 가 올리는 아티팩트(zip) 안의 MEON-Installer.exe 를 Authenticode 로 서명한다. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="MEON-Installer.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
